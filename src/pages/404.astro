---
import Site from '../layouts/Site.astro';
import { url } from '../lib/url';
---

<Site pageTitle="Page not found, Ahmad Assi" description="That page does not exist.">
  <section class="hero load">
    <p class="eyebrow" style="--i:0">Error &nbsp;/&nbsp; <em>404</em></p>
    <h1 class="page-title" style="--i:1">Off the map</h1>
    <p class="sub" style="--i:2">That page does not exist, or it has moved.</p>
    <p style="--i:3; margin-top:2.5rem">
      <a class="btn" href={url("/architecture")}>View the portfolio</a>
    </p>
  </section>
</Site>
