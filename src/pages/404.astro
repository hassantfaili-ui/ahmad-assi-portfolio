---
import Sheet from '../layouts/Sheet.astro';
---

<Sheet
  sheet="A-000"
  title="Sheet not in set"
  pageTitle="Sheet not found, Ahmad Assi"
  description="That sheet is not in this set."
  scale="NTS"
>
  <section class="band band-tall">
    <p class="anno">Void &nbsp;/&nbsp; Sheet not issued</p>
    <h1 style="margin-top:var(--s5)">That sheet is not in the set</h1>
    <p class="prose-lead" style="margin-top:var(--s5)">
      The drawing you asked for was either never issued or has been superseded.
    </p>
    <p style="margin-top:var(--s6)">
      <a class="btn btn-solid" href="/work">Open the project index</a>
    </p>
  </section>
</Sheet>
