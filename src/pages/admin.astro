---
import { url } from '../lib/url';

/**
 * A front door for the editor.
 *
 * /keystatic is where the editor actually lives, but it is not a name anybody
 * would guess or remember, and it is not linked from the site because visitors
 * have no business there. /admin is the address Ahmad is given, and it hands him
 * straight on.
 *
 * It redirects rather than iframing so the editor keeps its own URL and the back
 * button behaves. The markup below is only what shows if the redirect has not
 * fired yet, or if JavaScript is off, so it says something useful rather than
 * flashing a blank page.
 *
 * Prerendered on purpose. This has to work whether or not the editor is
 * deployed, because when it is not, this page is the only thing that explains
 * why the link appears to lead nowhere.
 */
export const prerender = true;
const editor = url('/keystatic');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Editor</title>
    <meta http-equiv="refresh" content={`0; url=${editor}`} />
    <style>
      :root { color-scheme: light dark; }
      body {
        margin: 0; min-height: 100vh; display: grid; place-items: center;
        font: 400 16px/1.6 ui-sans-serif, system-ui, sans-serif;
        background: #fff; color: #111; padding: 2rem;
      }
      @media (prefers-color-scheme: dark) { body { background: #0b0b0b; color: #f2f2f2; } }
      main { max-width: 34rem; text-align: center; }
      h1 { font-size: 1.1rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; }
      a { color: inherit; }
      p { color: #555; }
      @media (prefers-color-scheme: dark) { p { color: #aaa; } }
    </style>
  </head>
  <body>
    <main>
      <h1>Opening the editor</h1>
      <p>
        If nothing happens, <a href={editor}>open it here</a>.
      </p>
      <p>
        If that address says the page cannot be found, the editor has not been
        switched on for this site yet. See <code>docs/EDITING.md</code>.
      </p>
    </main>
  </body>
</html>
