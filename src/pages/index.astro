---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import Filmstrip from '../components/Filmstrip.astro';
import HeroFilm from '../components/HeroFilm.astro';
import resume from '../data/resume.json';
import { url } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

/* Short enough to read over moving footage. The full version is on the resume. */
const intro =
  'A graduate of the Bachelor of Architectural Studies at Carleton University, ' +
  'majoring in urbanism. I work between design and the site itself: masterplans ' +
  'and drawings on one side, construction and built interiors on the other.';
---

<Site
  pageTitle={`${resume.name}, ${resume.discipline}`}
  description={resume.positioning}
  hideFooterCta
>
  <HeroFilm
    eyebrow={`${resume.discipline} \u00a0/\u00a0 ${resume.location}`}
    name="Ahmad"
    surname="Assi"
    intro={intro}
    ctaLabel="Architecture"
    ctaHref="/architecture"
  />

  <section aria-labelledby="works">
    <h2 class="section-title" id="works">Projects</h2>
    <Filmstrip projects={projects} />
  </section>

  <!-- About and the invitation sit side by side and share a row, so the page
       closes on one gesture rather than two stacked centred blocks. -->
  <section class="band closing">
    <div class="closing-grid">
      <div class="closing-about reveal">
        <h2 class="closing-heading">About</h2>
        <div class="closing-prose">
          {resume.longBio.map((p) => <p>{p}</p>)}
        </div>
        <p style="margin-top:2rem">
          <a class="btn" href={url('/resume')}>
            Resume <span class="i" aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>

      <div class="closing-contact reveal">
        <p class="foot-kicker">Interested in collaborating?</p>
        <h2 class="closing-heading">Get in touch</h2>
        <ul class="closing-links">
          <li><a class="inline" href={`mailto:${resume.email}`}>{resume.email}</a></li>
          <li><a class="inline" href={`tel:${resume.phone.replace(/[^\d+]/g, '')}`}>{resume.phone}</a></li>
          <li><a class="inline" href={url('/contact')}>Contact page</a></li>
        </ul>
      </div>
    </div>
  </section>
</Site>
