---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Site from '../layouts/Site.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import HeroFilm from '../components/HeroFilm.astro';
import HomeAbout from '../components/islands/HomeAbout.astro';
import { getResume, listProjects } from '../lib/data';
import { islands } from '../lib/islands';

const projects = await listProjects();
const resume = await getResume();
const r = resume.data.resume;

/* Short enough to read over moving footage. The full version is on the resume. */
const intro =
  'A graduate of the Bachelor of Architectural Studies at Carleton University, ' +
  'majoring in urbanism. I work between design and the site itself: masterplans ' +
  'and drawings on one side, construction and built interiors on the other.';
---

<Site
  pageTitle={`${r.name}, ${r.discipline}`}
  description={r.positioning ?? ''}
  hideFooterCta
>
  <HeroFilm
    eyebrow={`${r.discipline} \u00a0/\u00a0 ${r.location}`}
    name="Ahmad"
    surname="Assi"
    intro={intro}
    ctaLabel="Architecture"
    ctaHref="/architecture"
  />

  <section aria-labelledby="works">
    <h2 class="section-title" id="works">Projects</h2>
    <ProjectGrid projects={projects} />
  </section>

  <!-- About and the invitation sit side by side and share a row, so the page
       closes on one gesture rather than two stacked centred blocks. -->
  <TinaIsland name="home-about" wrapper={islands['home-about'].wrapper} primary>
    <HomeAbout data={r} />
  </TinaIsland>
</Site>
