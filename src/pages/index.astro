---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import Filmstrip from '../components/Filmstrip.astro';
import HeroFilm from '../components/HeroFilm.astro';
import resume from '../data/resume.json';
import { url } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

/* Short enough to read over moving footage. The full version is on the resume. */
const intro =
  'A graduate of the Bachelor of Architectural Studies at Carleton University, ' +
  'majoring in urbanism. I work between design and the site itself: masterplans ' +
  'and drawings on one side, construction and built interiors on the other.';
---

<Site pageTitle={`${resume.name}, ${resume.discipline}`} description={resume.positioning}>
  <HeroFilm
    eyebrow={`${resume.discipline} \u00a0/\u00a0 ${resume.location}`}
    name="Ahmad"
    surname="Assi"
    intro={intro}
    ctaLabel="Architecture"
    ctaHref="/architecture"
  />

  <section aria-labelledby="works">
    <h2 class="section-title" id="works">Selected <em>Works</em></h2>
    <Filmstrip projects={projects} />
  </section>

  <section class="band">
    <h2 class="section-title">About</h2>
    <div class="prose reveal">
      {resume.longBio.map((p) => <p>{p}</p>)}
    </div>
    <p class="centre" style="margin-top:2.5rem">
      <a class="btn" href={url("/resume")}>
        Resume <span class="i" aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </section>
</Site>
