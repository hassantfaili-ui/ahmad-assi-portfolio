---
import Sheet from '../layouts/Sheet.astro';
import Drawing from '../components/Drawing.astro';
import resume from '../data/resume.json';

const marks = [
  { id: 'bio', label: 'A', name: 'Biography' },
  { id: 'history', label: 'B', name: 'Experience' },
  { id: 'record', label: 'C', name: 'Credentials and record' },
];

const columns = [
  { label: 'Education', items: resume.education.map((e) => ({ a: e.year, b: e.credential, c: e.institution })) },
  { label: 'Awards', items: resume.awards.map((e) => ({ a: e.year, b: e.title, c: e.detail })) },
  { label: 'Writing and exhibitions', items: [...resume.publications, ...resume.exhibitions].map((e) => ({ a: e.year, b: e.title, c: e.detail })) },
].filter((c) => c.items.length > 0);
---

<Sheet
  sheet="A-900"
  title="Curriculum vitae"
  pageTitle="About, Ahmad Assi"
  description="Ahmad Assi is an architect in Edmonton, Alberta, working in housing, civic and cultural projects."
  scale="NTS"
  marks={marks}
>
  <section class="band" id="bio">
    <p class="anno">A-900 &nbsp;/&nbsp; Curriculum vitae</p>

    <div class="bio">
      <div class="bio-portrait">
        <Drawing kind="axonometric" seed={901} alt={resume.portraitAlt} reg={false} />
        <p class="caption">{resume.portraitAlt}</p>
      </div>

      <div>
        <h1 style="font-size:var(--t-5)">{resume.discipline}, {resume.location}</h1>
        <div class="prose" style="margin-top:var(--s5)">
          {resume.longBio.map((p) => <p>{p}</p>)}
        </div>

        <div class="bio-actions">
          {
            resume.cvFile ? (
              <a class="btn btn-solid" href={resume.cvFile} download>
                Download CV, PDF
              </a>
            ) : (
              <p class="anno" style="border:var(--w-thin) dashed var(--line);padding:var(--s3) var(--s4)">
                PDF CV slot. Add the file to resume.json and this becomes a download button.
              </p>
            )
          }
          <a class="btn" href={`mailto:${resume.email}`}>Email</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="history">
    <div class="band-head">
      <p class="anno">B &nbsp;/&nbsp; Full experience</p>
      <span class="fill" aria-hidden="true"></span>
      <p class="anno">{resume.yearsExperience}</p>
    </div>

    <div class="entries">
      {
        resume.experience.map((r) => (
          <article class="entry reveal">
            <div>
              <p class="anno">{r.period}</p>
              <p class="anno" style="margin-top:4px">{r.location}</p>
            </div>
            <div>
              <h3 class="entry-role">{r.role}</h3>
              <p class="entry-firm">{r.firm}</p>
              <ul>
                {r.contributions.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="band" id="record">
    <div class="band-head">
      <p class="anno">C &nbsp;/&nbsp; Credentials and record</p>
      <span class="fill" aria-hidden="true"></span>
    </div>

    <div class="record">
      {
        columns.map((col) => (
          <div>
            <p class="dim dim-l"><span>{col.label}</span></p>
            <ul class="reset">
              {col.items.map((i) => (
                <li>
                  <p class="anno">{i.a}</p>
                  <p class="rec-title">{i.b}</p>
                  <p class="rec-detail">{i.c}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="split" style="margin-top:var(--s8)">
      <div>
        <p class="dim dim-l"><span>Registration</span></p>
        <p class="anno-lg">{resume.registration}</p>
      </div>
      <div>
        <p class="dim dim-l"><span>Languages</span></p>
        <div class="tags">
          {resume.languages.map((l) => <span class="tag">{l}</span>)}
        </div>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .bio {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: var(--s8);
    align-items: start;
    margin-top: var(--s6);
  }
  .bio-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-top: var(--s6);
  }

  .record {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s7);
  }
  .reset { list-style: none; margin: 0; padding: 0; }
  .reset li {
    padding: var(--s4) 0;
    border-top: var(--w-thin) solid var(--line-2);
  }
  .reset li:first-child { border-top: var(--w-med) solid var(--ink); }
  .rec-title {
    font-family: var(--display);
    font-stretch: 108%;
    font-weight: 550;
    font-size: var(--t-2);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: var(--s2) 0 var(--s1);
  }
  .rec-detail {
    font-family: var(--mono);
    font-size: var(--t-0);
    color: var(--ink-2);
    margin: 0;
  }

  @media (max-width: 920px) {
    .bio { grid-template-columns: 1fr; gap: var(--s5); }
    .record { grid-template-columns: 1fr; gap: var(--s6); }
  }
</style>
