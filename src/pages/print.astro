---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { markdownComponents } from '../components/markdown/components';
import type { Project } from '../lib/data';
import { drawingsOf, getResume, imageGroupsOf, imagesOf, leadImageOf, listProjects } from '../lib/data';
import { url } from '../lib/url';
import { tiers } from '../lib/tiers';
import '../styles/print.css';

/**
 * The portfolio PDF, as a web page.
 *
 * This exists so the document Ahmad attaches to an application and the link he
 * sends alongside it cannot drift apart. Both read the same files, in the same
 * order, with the same crediting. Change a project and both change.
 *
 * Rendered to PDF by scripts/build-portfolio.sh, which serves the built site and
 * drives headless Chrome. Images point at /print/, a set of downscaled copies the
 * script generates and then deletes: embedding the full resolution originals
 * makes a 25MB file, and application portals reject those.
 *
 * Not linked from the site navigation. It is a source file for a document, not a
 * page anyone should land on.
 */
const all = await listProjects();
const resume = (await getResume()).data.resume;

/* Same derivation as the home page, so a fourth project marked as a lead lands
   in the same place in both rather than making a spread here and vanishing there. */
const { leads, set, index } = tiers(all);

/**
 * Print sized copy of an image, generated by the build script.
 * Must go through url(): the document is rendered from a server mounted at the
 * Pages base path, and a bare /print/... 404s there, which silently produces a
 * PDF with no pictures in it.
 */
const pimg = (src: string) => url(`/print/${src.split('/').pop()}`);

/** Every gallery image, flattened, so a page can just take the first few. */
const gallery = (p: Project) =>
  imageGroupsOf(p)
    .flatMap((g) => imagesOf(g))
    .filter((i) => i.src.startsWith('/'));

const drawings = (p: Project) => drawingsOf(p).filter((d) => d.src.startsWith('/'));

const place = (s: string) => s.replace(/^\s*\d+[^,]*,\s*/, '');

/* Built from the configured site and base so the printed address always matches
   wherever the site is actually deployed. */
const liveUrl = new URL(import.meta.env.BASE_URL, Astro.site ?? 'https://example.com')
  .toString()
  .replace(/^https?:\/\//, '')
  .replace(/\/$/, '');

/* Sheet numbering runs across the whole document so a reviewer can refer to a
   page out loud. The cover is 01, the contents 02, and the work starts at 03. */
let sheet = 2;
const no = () => String(++sheet).padStart(2, '0');

/* Page numbers for the contents, worked out from the same shape the document is
   built in rather than typed in: two pages for each of the top three, then one
   for each of the set. Getting these from the structure means they cannot drift
   when a project moves between tiers. */
const FIRST_WORK_PAGE = 3;
const leadPage = (i: number) => FIRST_WORK_PAGE + i * 2;
const setPage = (i: number) => FIRST_WORK_PAGE + leads.length * 2 + i;
const archivePage = FIRST_WORK_PAGE + leads.length * 2 + set.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{resume.name}, portfolio</title>
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <!-- 01, cover -->
    <div class="sheet">
      <div class="cover-img">
        <img src={pimg('/media/lincoln-beach-center/lb-aerial-night-2.jpg')} alt="" />
      </div>
      <div class="cover-plate">
        <p class="p-label">Selected work &nbsp;&middot;&nbsp; {resume.issued}</p>
        <h1 class="cover-name">
          {resume.name.split(' ')[0]}<br />{resume.name.split(' ').slice(1).join(' ')}
        </h1>
        <p class="p-label" style="margin-bottom:5mm">
          {resume.discipline} &nbsp;&middot;&nbsp; {resume.location}
        </p>
        <div class="cover-meta">
          <span>{resume.email}</span>
          <span>{resume.phone}</span>
        </div>
      </div>
    </div>

    <!-- 02, contents: the site's three tiers, in the site's order -->
    <div class="sheet">
      <div class="plain">
        <p class="p-label">Selected work &nbsp;&middot;&nbsp; {resume.issued}</p>
        <h2 class="p-title">Contents</h2>

        <div class="toc">
          <div>
            <section class="toc-group toc-lead">
              <div class="toc-head">
                <p class="p-label">Selected projects</p>
                <p class="p-label">{leads.length}</p>
              </div>
              <ul class="toc-list">
                {
                  leads.map((p, i) => (
                    <li>
                      <span class="t">{p.title}</span>
                      <span class="n">{pad(leadPage(i))}</span>
                    </li>
                  ))
                }
              </ul>
            </section>

            <section class="toc-group toc-set">
              <div class="toc-head">
                <p class="p-label">The set</p>
                <p class="p-label">{set.length}</p>
              </div>
              <ul class="toc-list">
                {
                  set.map((p, i) => (
                    <li>
                      <span class="t">{p.title}</span>
                      <span class="n">{pad(setPage(i))}</span>
                    </li>
                  ))
                }
              </ul>
            </section>
          </div>

          <div>
            <section class="toc-group toc-archive">
              <div class="toc-head">
                <p class="p-label">Also in the archive &nbsp;&middot;&nbsp; page {pad(archivePage)}</p>
                <p class="p-label">{index.length}</p>
              </div>
              <ul class="toc-list">
                {
                  index.map((p) => (
                    <li>
                      <span class="t">{p.title}</span>
                      <span class="n">{p.year}</span>
                    </li>
                  ))
                }
              </ul>
            </section>

            <section class="toc-group toc-archive">
              <div class="toc-head">
                <p class="p-label">And</p>
                <p class="p-label">3</p>
              </div>
              <ul class="toc-list">
                <li><span class="t">Resume, experience</span><span class="n">{pad(archivePage + 1)}</span></li>
                <li><span class="t">Education and skills</span><span class="n">{pad(archivePage + 2)}</span></li>
                <li><span class="t">Contact</span><span class="n">{pad(archivePage + 3)}</span></li>
              </ul>
            </section>
          </div>
        </div>

        <p class="p-body" style="margin-top:auto;max-width:150mm">
          The same work, in the same order, as {liveUrl}.
        </p>
      </div>
      <p class="sheet-no">Contents &nbsp;/&nbsp; 02</p>
    </div>

    <!-- the three lead projects, two pages each -->
    {
      leads.map((p) => {
        const g = gallery(p);
        const d = drawings(p);
        /* Prefer drawings on the detail page: a plan or a section is what tells a
           reviewer the project was resolved, and renders already had the hero. */
        const picks = [...d.slice(0, 2), ...g].slice(0, 4);
        return (
          <>
            <div class="sheet">
              <div class="hero-img">
                <img src={pimg(leadImageOf(p).src)} alt="" />
              </div>
              <div class="hero-plate">
                <p class="p-label">{p.category} &nbsp;&middot;&nbsp; {p.year}</p>
                <h2 class="p-title">{p.title}</h2>
                <div class="hero-facts">
                  <span>{place(p.location)}</span>
                  <span>{p.status}</span>
                  {p.area && <span>{p.area}</span>}
                  <span><b>{p.credit}</b></span>
                </div>
              </div>
              <p class="sheet-no">{p.sheet} &nbsp;/&nbsp; {no()}</p>
            </div>

            <div class="sheet">
              <div class="detail">
                <div class="detail-text">
                  <p class="p-label">{p.buildingType}</p>
                  <h3 class="p-title">{p.title}</h3>
                  <div class="detail-body p-body">{p.body && <TinaMarkdown content={p.body} components={markdownComponents} />}</div>
                  <p class="detail-credit">{p.credit}</p>
                </div>
                <div class:list={['detail-grid', picks.length === 3 && 'is-three']}>
                  {picks.map((i) => (
                    <figure>
                      <img src={pimg(i.src)} alt="" />
                    </figure>
                  ))}
                </div>
              </div>
              <p class="sheet-no">{p.sheet} &nbsp;/&nbsp; {no()}</p>
            </div>
          </>
        );
      })
    }

    <!-- the set, one page each -->
    {
      set.map((p) => {
        const g = gallery(p);
        const d = drawings(p);
        const side = [...g.slice(0, 1), ...d.slice(0, 1)].slice(0, 2);
        while (side.length < 2 && g.length > side.length) side.push(g[side.length]);
        return (
          <div class="sheet">
            <div class="single">
              <div class="single-main">
                <img src={pimg(leadImageOf(p).src)} alt="" />
              </div>
              <div class="single-foot">
                <div class="single-text">
                  <p class="p-label">{p.category} &nbsp;&middot;&nbsp; {p.year}</p>
                  <h2 class="p-title">{p.title}</h2>
                  <p class="p-body">{p.summary}</p>
                  <p class="p-body" style="margin-top:3mm">
                    <b style="font-weight:400;color:var(--ink)">My part.</b>{' '}
                    {p.contribution}
                  </p>
                  <div class="hero-facts" style="margin-top:5mm">
                    <span>{place(p.location)}</span>
                    <span>{p.status}</span>
                    <span><b>{p.credit}</b></span>
                  </div>
                </div>
                <div class="single-strip">
                  {side.map((i) => (
                    <figure>
                      <img src={pimg(i.src)} alt="" />
                    </figure>
                  ))}
                </div>
              </div>
            </div>
            <p class="sheet-no">{p.sheet} &nbsp;/&nbsp; {no()}</p>
          </div>
        );
      })
    }

    <!-- the index -->
    <div class="sheet">
      <div class="plain">
        <p class="p-label">Also in the archive</p>
        <h2 class="p-title">Coursework and case studies</h2>
        <ul class="idx">
          {
            index.map((p) => (
              <li>
                <span class="y">{p.year}</span>
                <span class="t">{p.title}</span>
                <span class="k">{p.buildingType}</span>
                <span class="c">{p.credit}</span>
              </li>
            ))
          }
        </ul>
        <p class="p-body" style="margin-top:auto;max-width:170mm">
          Group work and studies of existing buildings, listed rather than shown.
          The full set is on the site, and I am happy to send drawings from any of
          them on request.
        </p>
      </div>
      <p class="sheet-no">Index &nbsp;/&nbsp; {no()}</p>
    </div>

    <!-- resume, experience -->
    <div class="sheet">
      <div class="plain">
        <p class="p-label">{resume.discipline} &nbsp;&middot;&nbsp; {resume.location}</p>
        <h2 class="p-title">Experience</h2>
        <div class="cv">
          {
            (resume.experience ?? []).map((e) => e && (
              <section>
                <div class="cv-item">
                  <b>{e.role}</b>
                  <p class="w">{e.firm} &nbsp;&middot;&nbsp; {e.period}</p>
                  <ul>
                    {(e.contributions ?? []).slice(0, 3).map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              </section>
            ))
          }
        </div>
      </div>
      <p class="sheet-no">Resume &nbsp;/&nbsp; {no()}</p>
    </div>

    <!-- resume, education and skills -->
    <div class="sheet">
      <div class="plain">
        <p class="p-label">{resume.name}</p>
        <h2 class="p-title">Education and skills</h2>
        <div class="cv">
          <section>
            <h3>Education</h3>
            {
              (resume.education ?? []).map((e) => e && (
                <div class="cv-item">
                  <b>{e.credential}</b>
                  <p class="w">{e.institution} &nbsp;&middot;&nbsp; {e.year}</p>
                  {e.note && <p class="p-body">{e.note}</p>}
                </div>
              ))
            }
            <h3 style="margin-top:7mm">Languages</h3>
            <div class="cv-tags">
              {(resume.languages ?? []).map((l) => <span>{l}</span>)}
            </div>
          </section>
          <section>
            {
              (resume.skillGroups ?? []).map((g) => g && (
                <>
                  <h3 style="margin-top:0">{g.label}</h3>
                  <div class="cv-tags" style="margin-bottom:6mm">
                    {(g.items ?? []).map((i) => (
                      <span>{i}</span>
                    ))}
                  </div>
                </>
              ))
            }
          </section>
        </div>
      </div>
      <p class="sheet-no">Resume &nbsp;/&nbsp; {no()}</p>
    </div>

    <!-- closing -->
    <div class="sheet">
      <div class="end">
        <div>
          <p class="p-label">{resume.availability}</p>
          <h2 class="p-title" style="margin-top:6mm">
            Happy to talk through any of this in person.
          </h2>
        </div>
        <div class="end-rows">
          <div><span>Email</span>{resume.email}</div>
          <div><span>Phone</span>{resume.phone}</div>
          <div><span>Based in</span>{resume.location}</div>
          <div><span>Portfolio</span>{liveUrl}</div>
        </div>
      </div>
    </div>
  </body>
</html>
