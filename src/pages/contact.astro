---
import Site from '../layouts/Site.astro';
import resume from '../data/resume.json';
import { url } from '../lib/url';

/**
 * Email first, form second.
 *
 * Netlify Forms handles the submission, which is why a form exists here at all.
 * It is rendered ONLY in a Netlify build. The same repository can be built for
 * GitHub Pages, which has nothing to post to, and a form that fails after
 * someone has typed their message is worse than no form. Gating it on the build
 * host means it cannot appear anywhere it would not work.
 *
 * Email stays the primary route because a practice writing to a graduate
 * attaches a brief or a job description, and no form field takes an attachment.
 *
 * Netlify needs the form present in the deployed HTML to register it, hence the
 * hidden form-name input. Spam is handled by a honeypot rather than a CAPTCHA,
 * which visitors should not have to solve to say hello.
 */
const netlifyForms = process.env.NETLIFY === 'true';
/* Empty in the data today, so TypeScript infers never[]. Typed here so the block
   below starts working the moment a link is added in the editor. */
const social = resume.social as { label: string; href: string }[];

const tel = resume.phone.replace(/[^\d+]/g, '');
const subject = encodeURIComponent('Enquiry from your portfolio');
const mailto = `mailto:${resume.email}?subject=${subject}`;
---

<Site
  pageTitle={`Contact, ${resume.name}`}
  description={`Get in touch with ${resume.name} in ${resume.location}.`}
>
  <section class="hero load">
    <p class="eyebrow" style="--i:0">{resume.location} &nbsp;/&nbsp; <em>Available now</em></p>
    <h1 class="page-title" style="--i:1">Contact</h1>
    <p class="sub" style="--i:2">{resume.availability}</p>
  </section>

  <section class="band">
    <div class="contact-grid">
      <div class="reveal">
        <h2 class="closing-heading">Write to me</h2>
        <p class="closing-prose" style="margin-top:1rem">
          Email is best, and it reaches me directly. Attach the brief, the job
          description or the drawing set and I will reply with whatever is useful,
          including work that is not on this site.
        </p>
        <p style="margin-top:2rem">
          <a class="btn" href={mailto}>
            {resume.email} <span class="i" aria-hidden="true">&rarr;</span>
          </a>
        </p>

        {
          netlifyForms && (
            <form
              class="form"
              name="enquiry"
              method="POST"
              action={url('/contact/sent')}
              data-netlify="true"
              netlify-honeypot="bot-field"
              data-contact
            >
              <p class="form-or">Or send a short note from here</p>

              {/* Netlify matches the submission to the form by this name. */}
              <input type="hidden" name="form-name" value="enquiry" />

              {/* Honeypot. Hidden from people, irresistible to bots. */}
              <p class="hp" aria-hidden="true">
                <label>
                  Do not fill this in
                  <input name="bot-field" tabindex="-1" autocomplete="off" />
                </label>
              </p>

              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" type="text" autocomplete="name" required />
                <span class="err" data-err-for="name" hidden />
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required />
                <span class="err" data-err-for="email" hidden />
              </div>

              <div class="field">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="4" required />
                <span class="err" data-err-for="message" hidden />
              </div>

              <button class="btn" type="submit">Send</button>
            </form>
          )
        }
      </div>

      <div class="reveal">
        <dl class="contact-facts">
          <div>
            <dt>Email</dt>
            <dd><a class="inline" href={`mailto:${resume.email}`}>{resume.email}</a></dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a class="inline" href={`tel:${tel}`}>{resume.phone}</a></dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>{resume.location}</dd>
          </div>
          {
            social.length > 0 && (
              <div>
                <dt>Elsewhere</dt>
                <dd>
                  {social.map((s) => (
                    <a class="inline" href={s.href} style="display:block">
                      {s.label}
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>

        {
          (resume.cvFile || resume.portfolioFile) && (
            <p class="contact-files">
              {resume.portfolioFile && (
                <a class="btn" href={url(resume.portfolioFile)} download>
                  Portfolio PDF <span class="i" aria-hidden="true">&darr;</span>
                </a>
              )}
              {resume.cvFile && (
                <a class="btn" href={url(resume.cvFile)} download>
                  Resume PDF <span class="i" aria-hidden="true">&darr;</span>
                </a>
              )}
            </p>
          )
        }
      </div>
    </div>
  </section>
</Site>

<script>
  /* Validation only, and only if the form is on the page at all. The submission
     is Netlify's job. `novalidate` is deliberately not set, so with JavaScript
     off the browser's own required-field checks still apply. */
  const form = document.querySelector<HTMLFormElement>('[data-contact]');

  if (form) {
    const RULES: Record<string, (v: string) => string | null> = {
      name: (v) => (v.trim() ? null : 'Add your name so Ahmad knows who is writing.'),
      email: (v) =>
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? null : 'Check the email address.',
      message: (v) => (v.trim().length >= 12 ? null : 'A little more detail, at least a sentence.'),
    };

    function setError(name: string, message: string | null) {
      const err = document.querySelector<HTMLElement>(`[data-err-for="${name}"]`);
      const input = form!.elements.namedItem(name) as HTMLInputElement | null;
      if (!err || !input) return;
      err.textContent = message ?? '';
      err.hidden = !message;
      input.setAttribute('aria-invalid', message ? 'true' : 'false');
    }

    form.addEventListener('submit', (e) => {
      let firstBad: HTMLInputElement | null = null;
      for (const [name, rule] of Object.entries(RULES)) {
        const input = form.elements.namedItem(name) as HTMLInputElement | null;
        if (!input) continue;
        const message = rule(input.value);
        setError(name, message);
        if (message && !firstBad) firstBad = input;
      }
      if (firstBad) {
        e.preventDefault();
        firstBad.focus();
      }
    });

    form.querySelectorAll<HTMLInputElement>('input, textarea').forEach((input) => {
      input.addEventListener('blur', () => {
        const rule = RULES[input.name];
        if (rule) setError(input.name, rule(input.value));
      });
    });
  }
</script>
