---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Site from '../layouts/Site.astro';
import ContactBody from '../components/islands/ContactBody.astro';
import { getResume } from '../lib/data';
import { islands } from '../lib/islands';

const r = (await getResume()).data.resume;
---

<Site
  pageTitle={`Contact, ${r.name}`}
  description={`Get in touch with ${r.name} in ${r.location}.`}
>
  <TinaIsland name="contact" wrapper={islands.contact.wrapper} primary>
    <ContactBody data={r} />
  </TinaIsland>
</Site>
