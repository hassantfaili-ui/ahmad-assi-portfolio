---
import Site from '../layouts/Site.astro';
import resume from '../data/resume.json';
import { url } from '../lib/url';

/**
 * Email only.
 *
 * There is no form. Cloudflare has nothing that accepts a submission without a
 * third party service, and markup that silently posts nowhere is worse than
 * none. Email was always the primary route anyway: a practice writing to a
 * graduate attaches a brief or a job description, and no form field takes an
 * attachment.
 */
/* Empty in the data today, so TypeScript infers never[]. Typed here so the block
   below starts working the moment a link is added to src/data/resume.json. */
const social = resume.social as { label: string; href: string }[];

const tel = resume.phone.replace(/[^\d+]/g, '');
const subject = encodeURIComponent('Enquiry from your portfolio');
const mailto = `mailto:${resume.email}?subject=${subject}`;
---

<Site
  pageTitle={`Contact, ${resume.name}`}
  description={`Get in touch with ${resume.name} in ${resume.location}.`}
>
  <section class="hero load">
    <p class="eyebrow" style="--i:0">{resume.location} &nbsp;/&nbsp; <em>Available now</em></p>
    <h1 class="page-title" style="--i:1">Contact</h1>
    <p class="sub" style="--i:2">{resume.availability}</p>
  </section>

  <section class="band">
    <div class="contact-grid">
      <div class="reveal">
        <h2 class="closing-heading">Write to me</h2>
        <p class="closing-prose" style="margin-top:1rem">
          Email is best, and it reaches me directly. Attach the brief, the job
          description or the drawing set and I will reply with whatever is useful,
          including work that is not on this site.
        </p>
        <p style="margin-top:2rem">
          <a class="btn" href={mailto}>
            {resume.email} <span class="i" aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>

      <div class="reveal">
        <dl class="contact-facts">
          <div>
            <dt>Email</dt>
            <dd><a class="inline" href={`mailto:${resume.email}`}>{resume.email}</a></dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a class="inline" href={`tel:${tel}`}>{resume.phone}</a></dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>{resume.location}</dd>
          </div>
          {
            social.length > 0 && (
              <div>
                <dt>Elsewhere</dt>
                <dd>
                  {social.map((s) => (
                    <a class="inline" href={s.href} style="display:block">
                      {s.label}
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>

        {
          (resume.cvFile || resume.portfolioFile) && (
            <p class="contact-files">
              {resume.portfolioFile && (
                <a class="btn" href={url(resume.portfolioFile)} download>
                  Portfolio PDF <span class="i" aria-hidden="true">&darr;</span>
                </a>
              )}
              {resume.cvFile && (
                <a class="btn" href={url(resume.cvFile)} download>
                  Resume PDF <span class="i" aria-hidden="true">&darr;</span>
                </a>
              )}
            </p>
          )
        }
      </div>
    </div>
  </section>
</Site>
