---
import Curated from '../layouts/Curated.astro';
import resume from '../data/resume.json';

/** Set to the host's form handler once hosting is chosen. See the README. */
const FORM_ENDPOINT = '';
---

<Curated
  pageTitle={`Contact, ${resume.name}`}
  description={`Get in touch with ${resume.name} in ${resume.location}.`}
>
  <section class="hero load">
    <h1 style="--i:0">Contact</h1>
    <p class="sub" style="--i:1">{resume.availability}</p>
  </section>

  <section class="band">
    <dl class="meta reveal" style="padding-bottom:3rem">
      <div>
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${resume.email}`} style="border-bottom:1px solid var(--ink-3)">
            {resume.email}
          </a>
        </dd>
      </div>
      <div>
        <dt>Phone</dt>
        <dd>
          <a href={`tel:${resume.phone.replace(/[^\d+]/g, '')}`}>{resume.phone}</a>
        </dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>{resume.location}</dd>
      </div>
    </dl>

    <form
      class="form reveal"
      method="post"
      action={FORM_ENDPOINT || undefined}
      novalidate
      data-contact
      data-endpoint={FORM_ENDPOINT}
      style="max-width:34rem;margin:0 auto"
    >
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
        <span class="err" data-err-for="name" hidden></span>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
        <span class="err" data-err-for="email" hidden></span>
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" required></textarea>
        <span class="err" data-err-for="message" hidden></span>
      </div>

      <!-- honeypot instead of a CAPTCHA -->
      <div aria-hidden="true" style="position:absolute;left:-9999px">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button class="btn" type="submit">Send message</button>
      <p class="notice" data-notice role="status" hidden></p>
    </form>
  </section>
</Curated>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const notice = document.querySelector<HTMLElement>('[data-notice]');

  function setError(name: string, message: string | null) {
    const err = document.querySelector<HTMLElement>(`[data-err-for="${name}"]`);
    const input = form?.elements.namedItem(name) as HTMLInputElement | null;
    if (!err || !input) return;
    err.textContent = message ?? '';
    err.hidden = !message;
    input.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  const RULES: Record<string, (v: string) => string | null> = {
    name: (v) => (v.trim() ? null : 'Add your name so Ahmad knows who is writing.'),
    email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? null : 'Check the email address.'),
    message: (v) => (v.trim().length >= 12 ? null : 'A little more detail, at least a sentence.'),
  };

  form?.addEventListener('submit', (e) => {
    let firstBad: HTMLInputElement | null = null;
    for (const [name, rule] of Object.entries(RULES)) {
      const input = form.elements.namedItem(name) as HTMLInputElement | null;
      if (!input) continue;
      const message = rule(input.value);
      setError(name, message);
      if (message && !firstBad) firstBad = input;
    }
    if (firstBad) {
      e.preventDefault();
      firstBad.focus();
      return;
    }
    // Not connected to a handler yet: say so rather than fake a success.
    if (!form.dataset.endpoint) {
      e.preventDefault();
      if (notice) {
        notice.hidden = false;
        notice.innerHTML =
          'The form is not connected to a handler yet, so nothing was sent. Email <a href="mailto:ahmadassi2003@hotmail.com">ahmadassi2003@hotmail.com</a> in the meantime.';
      }
    }
  });

  form?.querySelectorAll<HTMLInputElement>('input, textarea').forEach((input) => {
    input.addEventListener('blur', () => {
      const rule = RULES[input.name];
      if (rule) setError(input.name, rule(input.value));
    });
  });
</script>
