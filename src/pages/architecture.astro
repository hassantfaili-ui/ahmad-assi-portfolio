---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import resume from '../data/resume.json';
import { url } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Site
  pageTitle={`Architecture, ${resume.name}`}
  description="Architectural and urbanism work by Ahmad Assi, including the Lincoln Beach Center and La Casa Aranas."
>
  <section class="hero load">
    <p class="eyebrow" style="--i:0">
Architecture and urbanism &nbsp;/&nbsp; <em>{projects.length} projects</em>
    </p>
    <h1 class="page-title" style="--i:1">Projects</h1>
    <p class="sub" style="--i:2">
      A selection of my work. Explore the projects to learn more about what I do.
    </p>
  </section>

  <ProjectGrid projects={projects} />
</Site>
