---
import Site from '../../layouts/Site.astro';
import { getResume } from '../../lib/data';
import { url } from '../../lib/url';

/**
 * Where the contact form used to land after a submission was accepted.
 *
 * Nothing reaches it now: the form went with the move off Netlify, and the
 * contact page is the email link. It is kept because the address may still be in
 * somebody's history or a bookmark, and a styled page saying the message arrived
 * is a better answer to that than a 404.
 */
const resume = (await getResume()).data.resume;
---

<Site
  pageTitle={`Message sent, ${resume.name}`}
  description="Confirmation that your message reached Ahmad Assi."
>
  <section class="hero load">
    <p class="eyebrow" style="--i:0">Contact &nbsp;/&nbsp; <em>Sent</em></p>
    <h1 class="page-title" style="--i:1">Thank you</h1>
    <p class="sub" style="--i:2">
      Your message has reached Ahmad and he will reply to the address you gave.
    </p>
  </section>

  <section class="band">
    <div class="contact-grid">
      <div class="reveal">
        <h2 class="closing-heading">In the meantime</h2>
        <p class="closing-prose" style="margin-top:1rem">
          If you have a brief, a job description or a drawing set to send, email
          is the better route, because an attachment will not fit through a form.
        </p>
        <p style="margin-top:2rem">
          <a class="btn" href={`mailto:${resume.email}`}>
            {resume.email} <span class="i" aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>

      <div class="reveal">
        <h2 class="closing-heading">Take the work with you</h2>
        <p class="contact-files" style="margin-top:1.5rem">
          {
            resume.portfolioFile && (
              <a class="btn" href={url(resume.portfolioFile)} download>
                Portfolio PDF <span class="i" aria-hidden="true">&darr;</span>
              </a>
            )
          }
          {
            resume.cvFile && (
              <a class="btn" href={url(resume.cvFile)} download>
                Resume PDF <span class="i" aria-hidden="true">&darr;</span>
              </a>
            )
          }
        </p>
        <p style="margin-top:2rem">
          <a class="inline" href={url('/architecture')}>Back to the projects</a>
        </p>
      </div>
    </div>
  </section>
</Site>
