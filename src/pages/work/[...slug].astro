---
import { getCollection, render } from 'astro:content';
import Curated from '../../layouts/Curated.astro';
import Drawing from '../../components/Drawing.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const isFile = (s?: string) => Boolean(s && s.startsWith('/'));

/* Only the facts that exist. An empty row is worse than no row. */
const facts = [
  ['Project type', d.buildingType],
  ['Location', d.location],
  ['Status', d.status],
  ['Area', d.area],
  ['Role', d.role],
].filter(([, v]) => v);

const gallery = d.imageGroups.flatMap((g) =>
  g.images.map((img) => ({ ...img, caption: g.caption })),
);
const showLead = gallery.length > 0;
---

<Curated pageTitle={`${d.title}, Ahmad Assi`} description={d.summary}>
  <section class="hero load">
    <h1 style="--i:0">{d.title}</h1>
    <p class="sub" style="--i:1">{d.summary}</p>
  </section>

  <dl class="meta reveal">
    {
      facts.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))
    }
  </dl>

  <div class="prose reveal">
    <Content />
  </div>

  <div class="stagger">
    {
      showLead && (
        <figure class="reveal">
          {isFile(d.leadImage.src) ? (
            <img src={d.leadImage.src} alt={d.leadImage.alt} loading="lazy" decoding="async" />
          ) : (
            <Drawing kind={d.leadImage.kind} seed={d.leadImage.seed} alt={d.leadImage.alt} reg={false} />
          )}
        </figure>
      )
    }
    {
      gallery.map((img) => (
        <figure class="reveal">
          {isFile(img.src) ? (
            <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
          ) : (
            <Drawing kind={img.kind} seed={img.seed} alt={img.alt} reg={false} />
          )}
          {img.caption && <figcaption>{img.caption}</figcaption>}
        </figure>
      ))
    }
    {
      !showLead && (
        <figure class="reveal" style="grid-column:1 / -1;margin-top:0">
          {isFile(d.leadImage.src) ? (
            <img src={d.leadImage.src} alt={d.leadImage.alt} loading="lazy" decoding="async" />
          ) : (
            <Drawing kind={d.leadImage.kind} seed={d.leadImage.seed} alt={d.leadImage.alt} reg={false} />
          )}
        </figure>
      )
    }
  </div>

  <nav class="pager" aria-label="Other projects">
    <a href={`/work/${prev.id}`}>
      <span class="i" aria-hidden="true">&#8249;</span> Previous Project
    </a>
    <a href={`/work/${next.id}`}>
      Next Project <span class="i" aria-hidden="true">&#8250;</span>
    </a>
  </nav>
</Curated>
