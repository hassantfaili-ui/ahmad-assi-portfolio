---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Drawing from '../../components/Drawing.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const isFile = (s?: string) => Boolean(s && s.startsWith('/'));

/* Only rows that have a value. An empty row is worse than no row. */
const facts = [
  ['Project type', d.buildingType],
  ['Location', d.location],
  ['Status', d.status],
  ['Area', d.area],
  ['Role', d.role],
].filter(([, v]) => v);

const gallery = d.imageGroups.flatMap((g) =>
  g.images.map((img) => ({ ...img, caption: g.caption })),
);
---

<Site pageTitle={`${d.title}, Ahmad Assi`} description={d.summary}>
  <section class="hero load">
    <p class="eyebrow" style="--i:0">
      {d.category} &nbsp;/&nbsp; <em>{d.year}</em>
    </p>
    <h1 class="page-title" style="--i:1">{d.title}</h1>
    <p class="sub" style="--i:2">{d.summary}</p>
  </section>

  <dl class="meta reveal">
    {
      facts.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))
    }
  </dl>

  <div class="band">
    <div class="prose reveal">
      <Content />
    </div>
  </div>

  {
    d.film && (
      <section class="band" aria-labelledby="film">
        <h2 class="section-title" id="film">Walkthrough</h2>
        <figure class="film-frame reveal">
          <video
            controls
            preload="none"
            playsinline
            poster={url(d.film.poster)}
            src={url(d.film.src)}
          />
          {d.film.caption && <figcaption>{d.film.caption}</figcaption>}
        </figure>
      </section>
    )
  }

  <div class="stagger">
    <figure class="reveal">
      {
        isFile(d.leadImage.src) ? (
          <img src={url(d.leadImage.src)} alt={d.leadImage.alt} loading="lazy" decoding="async" />
        ) : (
          <Drawing kind={d.leadImage.kind} seed={d.leadImage.seed} alt={d.leadImage.alt} reg={false} />
        )
      }
    </figure>
    {
      gallery.map((img) => (
        <figure class="reveal">
          {isFile(img.src) ? (
            <img src={url(img.src)} alt={img.alt} loading="lazy" decoding="async" />
          ) : (
            <Drawing kind={img.kind} seed={img.seed} alt={img.alt} reg={false} />
          )}
          {img.caption && <figcaption>{img.caption}</figcaption>}
        </figure>
      ))
    }
  </div>

  {
    d.drawings.length > 0 && (
      <section class="band" aria-labelledby="drawings">
        <h2 class="section-title" id="drawings">Drawings</h2>
        <div class="sheets">
          {d.drawings.map((dr) => (
            <figure class="reveal">
              {isFile(dr.src) ? (
                <img src={url(dr.src)} alt={dr.alt} loading="lazy" decoding="async" />
              ) : (
                <Drawing kind={dr.kind} seed={dr.seed} alt={dr.alt} reg={false} />
              )}
              <figcaption>{dr.drawingType}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <nav class="pager" aria-label="Other projects">
    <a href={url(`/work/${prev.id}`)}>
      <span aria-hidden="true">&#8249;</span> Previous
    </a>
    <a href={url(`/work/${next.id}`)}>
      Next <span aria-hidden="true">&#8250;</span>
    </a>
  </nav>
</Site>
