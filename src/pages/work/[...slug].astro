---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Site from '../../layouts/Site.astro';
import ProjectBody from '../../components/islands/ProjectBody.astro';
import { getProject, listProjects, slugOf } from '../../lib/data';
import { islands } from '../../lib/islands';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await listProjects();
  return projects.map((project, i) => ({
    params: { slug: slugOf(project) },
    props: {
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { prev, next } = Astro.props;
const slug = (Astro.params.slug ?? '').toString();

/* Fetched here rather than passed through getStaticPaths on purpose. The result
   carries the metadata that makes the page editable, and that metadata is
   recorded per render: handing a pre-fetched document down as a prop would draw
   the same page and lose the editor. */
const project = await getProject(slug);
const d = project.data.projects;
---

<Site pageTitle={`${d.title}, Ahmad Assi`} description={d.summary}>
  <TinaIsland name="project" wrapper={islands.project.wrapper} params={{ slug }} primary>
    <ProjectBody data={d} />
  </TinaIsland>

  <nav class="pager" aria-label="Other projects">
    <a href={url(`/work/${slugOf(prev)}`)}>
      <span aria-hidden="true">&#8249;</span> Previous
    </a>
    <a href={url(`/work/${slugOf(next)}`)}>
      Next <span aria-hidden="true">&#8250;</span>
    </a>
  </nav>
</Site>
