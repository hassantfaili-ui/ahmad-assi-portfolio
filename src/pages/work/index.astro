---
import { getCollection } from 'astro:content';
import Sheet from '../../layouts/Sheet.astro';
import Drawing from '../../components/Drawing.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const categories = [...new Set(projects.map((p) => p.data.category))].sort();
---

<Sheet
  sheet="A-100"
  title="Project index"
  pageTitle="Work, Ahmad Assi"
  description="Every project in the set: housing, civic and cultural work, competitions and academic projects."
  scale="1:100"
>
  <section class="band">
    <p class="anno">A-100 &nbsp;/&nbsp; Project index</p>
    <h1 style="margin-top:var(--s4)">Work</h1>
    <p class="prose-lead" style="margin-top:var(--s5);max-width:44ch">
      Six projects, ordered as a drawing set rather than by date. Each sheet states what I did on
      it, which is not always the same as what the office did.
    </p>
  </section>

  <section class="band band-tight">
    <div class="index-bar">
      <div class="filters" role="group" aria-label="Filter projects by category">
        <button class="filter" type="button" data-filter="all" aria-pressed="true">All</button>
        {
          categories.map((c) => (
            <button class="filter" type="button" data-filter={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>
      <p class="anno" data-tally aria-live="polite">{projects.length} projects</p>
    </div>
  </section>

  <section class="band">
    <div class="grid-3">
      {
        projects.map((p) => (
          <a class="card reveal" href={`/work/${p.id}`} data-category={p.data.category}>
            <Drawing
              kind={p.data.leadImage.kind}
              seed={p.data.leadImage.seed}
              alt={p.data.leadImage.alt}
            />
            <div class="card-meta">
              <span class="card-title">{p.data.title}</span>
              <span class="card-sheet">{p.data.sheet}</span>
            </div>
            <p class="anno" style="margin-top:6px">
              {p.data.category} &nbsp;&middot;&nbsp; {p.data.year} &nbsp;&middot;&nbsp; {p.data.status}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Sheet>

<style>
  .index-bar {
    display: flex;
    align-items: center;
    gap: var(--s5);
    flex-wrap: wrap;
  }
  .index-bar .anno { margin-left: auto; }

  @media (max-width: 920px) {
    .index-bar .anno { margin-left: 0; }
  }
</style>
