---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Site from '../layouts/Site.astro';
import ResumeBody from '../components/islands/ResumeBody.astro';
import { getResume } from '../lib/data';
import { islands } from '../lib/islands';

const resume = await getResume();
const r = resume.data.resume;
---

<Site
  pageTitle={`Resume, ${r.name}`}
  description={`Curriculum vitae for ${r.name}, ${r.discipline} in ${r.location}.`}
>
  <TinaIsland name="resume" wrapper={islands.resume.wrapper} primary>
    <ResumeBody data={r} />
  </TinaIsland>
</Site>
