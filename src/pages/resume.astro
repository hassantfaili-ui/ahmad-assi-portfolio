---
import Site from '../layouts/Site.astro';
import SkillIcon from '../components/SkillIcon.astro';
import resume from '../data/resume.json';
import { url } from '../lib/url';
---

<Site
  pageTitle={`Resume, ${resume.name}`}
  description={`Curriculum vitae for ${resume.name}, ${resume.discipline} in ${resume.location}.`}
>
  <section class="hero load">
    <p class="eyebrow" style="--i:0">
      {resume.credential} &nbsp;/&nbsp; <em>{resume.yearsExperience}</em>
    </p>
    <h1 class="page-title" style="--i:1">Resume</h1>
    <p class="sub" style="--i:2">
      {resume.location} &nbsp;/&nbsp; {resume.phone} &nbsp;/&nbsp;
      <a class="inline" href={`mailto:${resume.email}`}>{resume.email}</a>
    </p>
  </section>

  <!-- A reader scans before they read. Categories with a few lines each, and the
       full document one click away, rather than three paragraphs of prose. -->
  <section class="band">
    <div class="atglance">
      <div class="atglance-item reveal">
        <p class="group-label">Qualification</p>
        <ul>
          <li>B.A.S. (Honours), Urbanism major, Carleton University, 2025</li>
          <li>Dean's Honour List, Faculty of Engineering and Design</li>
          <li>International Baccalaureate, 2021</li>
        </ul>
      </div>

      <div class="atglance-item reveal">
        <p class="group-label">Practice</p>
        <ul>
          <li>Independent residential design since 2023, one house under construction</li>
          <li>Built interiors and landscape delivered, not only drawn</li>
          <li>Project support on Government of Canada work, 2025</li>
        </ul>
      </div>

      <div class="atglance-item reveal">
        <p class="group-label">On site</p>
        <ul>
          <li>Five years of residential construction labour across Ottawa</li>
          <li>Site preparation, landscaping, finishing and installations</li>
          <li>Detailing informed by having built the thing</li>
        </ul>
      </div>

      <div class="atglance-item reveal">
        <p class="group-label">Beyond the studio</p>
        <ul>
          <li>Four languages: English, French and Arabic fluent, Spanish intermediate</li>
          <li>Scouts leader and youth programme admin, ABCCO</li>
          <li>Four years running a kitchen, ending as senior chef</li>
        </ul>
      </div>
    </div>

    {
      resume.cvFile && (
        <p class="centre" style="margin-top:clamp(2.5rem,6vw,4rem)">
          <a class="btn" href={url(resume.cvFile)} download>
            Full resume, PDF <span class="i" aria-hidden="true">&darr;</span>
          </a>
        </p>
      )
    }
  </section>

  <section class="band">
    <h2 class="section-title">Education</h2>
    <ul class="list">
      {
        resume.education.map((e) => (
          <li class="reveal">
            <p class="when">{e.year || 'Completed'}</p>
            <div>
              <h3 class="r">{e.credential}</h3>
              <p class="f">{e.institution}</p>
              {e.note && <p style="margin:0.6rem 0 0;color:var(--ink-2)">{e.note}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band">
    <h2 class="section-title">Experience</h2>
    <ul class="list">
      {
        resume.experience.map((r) => (
          <li class="reveal">
            <p class="when">{r.period}</p>
            <div>
              <h3 class="r">{r.role}</h3>
              <p class="f">{r.firm} &nbsp;/&nbsp; {r.location}</p>
              <ul>
                {r.contributions.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {
    resume.volunteering.length > 0 && (
      <section class="band">
        <h2 class="section-title">Community</h2>
        <ul class="list">
          {resume.volunteering.map((v) => (
            <li class="reveal">
              <p class="when">{v.year || 'Ongoing'}</p>
              <div>
                <h3 class="r">{v.title}</h3>
                <p class="f">{v.detail}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="band">
    <h2 class="section-title">Skills</h2>
    {
      resume.skillGroups.map((g) => (
        <div class="reveal" style="margin-bottom:2.75rem">
          <p class="group-label">{g.label}</p>
          {/* Software is a set of tools, so it is drawn rather than listed. The
              rest are things he does, which only words describe. */}
          {g.label.toLowerCase() === 'software' ? (
            <ul class="software">
              {g.items.map((i) => (
                <li>
                  <SkillIcon name={i} />
                  <span>{i}</span>
                </li>
              ))}
            </ul>
          ) : (
            <div class="tags">
              {g.items.map((i) => (
                <span class="tag">{i}</span>
              ))}
            </div>
          )}
        </div>
      ))
    }
    <div class="reveal">
      <p class="group-label">Languages</p>
      <div class="tags">
        {resume.languages.map((l) => <span class="tag">{l}</span>)}
      </div>
    </div>
    <p class="group-label" style="margin-top:3rem">
      References {resume.references.toLowerCase()}
    </p>
  </section>
</Site>
