---
import Datum from '../layouts/Datum.astro';
import resume from '../data/resume.json';
---

<Datum
  pageTitle={`Resume, ${resume.name}`}
  description={`Curriculum vitae for ${resume.name}, ${resume.discipline} in ${resume.location}.`}
>
  <section class="hero load">
    <p class="eyebrow" style="--i:0">
      {resume.credential} &nbsp;/&nbsp; <em>{resume.yearsExperience}</em>
    </p>
    <h1 class="page-title" style="--i:1">Resume</h1>
    <p class="sub" style="--i:2">
      {resume.location} &nbsp;/&nbsp; {resume.phone} &nbsp;/&nbsp;
      <a class="inline" href={`mailto:${resume.email}`}>{resume.email}</a>
    </p>
    {
      resume.cvFile && (
        <p style="--i:3; margin-top:2.5rem">
          <a class="btn" href={resume.cvFile} download>
            Download PDF
          </a>
        </p>
      )
    }
  </section>

  <section class="band">
    <h2 class="section-title">Profile</h2>
    <div class="prose reveal">
      {resume.longBio.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="band">
    <h2 class="section-title">Education</h2>
    <ul class="list">
      {
        resume.education.map((e) => (
          <li class="reveal">
            <p class="when">{e.year || 'Completed'}</p>
            <div>
              <h3 class="r">{e.credential}</h3>
              <p class="f">{e.institution}</p>
              {e.note && <p style="margin:0.6rem 0 0;color:var(--ink-2)">{e.note}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band">
    <h2 class="section-title">Experience</h2>
    <ul class="list">
      {
        resume.experience.map((r) => (
          <li class="reveal">
            <p class="when">{r.period}</p>
            <div>
              <h3 class="r">{r.role}</h3>
              <p class="f">{r.firm} &nbsp;/&nbsp; {r.location}</p>
              <ul>
                {r.contributions.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {
    resume.volunteering.length > 0 && (
      <section class="band">
        <h2 class="section-title">Community</h2>
        <ul class="list">
          {resume.volunteering.map((v) => (
            <li class="reveal">
              <p class="when">{v.year || 'Ongoing'}</p>
              <div>
                <h3 class="r">{v.title}</h3>
                <p class="f">{v.detail}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="band">
    <h2 class="section-title">Skills</h2>
    {
      resume.skillGroups.map((g) => (
        <div class="reveal" style="margin-bottom:2.75rem">
          <p class="group-label">{g.label}</p>
          <div class="tags">
            {g.items.map((i) => (
              <span class="tag">{i}</span>
            ))}
          </div>
        </div>
      ))
    }
    <div class="reveal">
      <p class="group-label">Languages</p>
      <div class="tags">
        {resume.languages.map((l) => <span class="tag">{l}</span>)}
      </div>
    </div>
    <p class="group-label" style="margin-top:3rem">
      References {resume.references.toLowerCase()}
    </p>
  </section>
</Datum>
