---
import '../styles/global.css';
import TitleBlock from '../components/TitleBlock.astro';
import { SHEETS } from '../lib/sheets';
import resume from '../data/resume.json';

interface Mark {
  id: string;
  label: string;
  name: string;
}

interface Props {
  sheet: string;
  title: string;
  pageTitle?: string;
  description: string;
  scale?: string;
  revision?: string;
  marks?: Mark[];
}

const {
  sheet,
  title,
  pageTitle,
  description,
  scale = 'NTS',
  revision = 'A',
  marks = [],
} = Astro.props;

const issued = resume.issued;
const head = pageTitle ?? `${title}, ${resume.name}`;
---

<!doctype html>
<html lang="en-CA" data-print="bond">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{head}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={head} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="theme-color" content="#e9eae3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d2842" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Set the print type before first paint so the sheet never flashes.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var saved = localStorage.getItem('print-type');
          if (saved === 'bond' || saved === 'blueline') {
            root.dataset.print = saved;
            return;
          }
        } catch (e) {}
        root.dataset.print = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'blueline'
          : 'bond';
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to sheet</a>

    {
      marks.length > 0 && (
        <nav class="gridrail" aria-label="Sections on this sheet">
          {marks.map((m) => (
            <a class="bubble" href={`#${m.id}`} title={m.name} aria-label={m.name}>
              {m.label}
            </a>
          ))}
        </nav>
      )
    }

    <TitleBlock sheet={sheet} title={title} scale={scale} revision={revision} issued={issued} />

    <div class="shell">
      <main class="sheet" id="main">
        <slot />
      </main>
    </div>

    <!-- sheet index, narrow screens only -->
    <div class="menu" data-menu id="sheet-index">
      <button class="menu-close" type="button" data-menu-close>Close</button>
      {
        SHEETS.map((s) => (
          <a href={s.href}>
            <span class="n">{s.sheet}</span>
            {s.short}
          </a>
        ))
      }
    </div>

    <!-- full screen drawing viewer -->
    <div class="zoom" data-zoom-view role="dialog" aria-modal="true" aria-label="Drawing viewer">
      <div class="zoom-bar">
        <span class="anno" data-zoom-label>Drawing</span>
        <span class="anno" style="margin-left:auto">Click the drawing to magnify</span>
        <button class="btn" type="button" data-zoom-close>Close</button>
      </div>
      <div class="zoom-stage" data-zoom-stage></div>
    </div>

    <script>
      import '../scripts/sheet';
    </script>
  </body>
</html>
