---
import type { CollectionEntry } from 'astro:content';
import Drawing from './Drawing.astro';
import { url } from '../lib/url';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const isFile = (s?: string) => Boolean(s && s.startsWith('/'));

/** Only rows that have a value. An empty row is worse than no row. */
function facts(d: CollectionEntry<'projects'>['data']) {
  return [
    ['Type', d.buildingType],
    ['Location', d.location],
    ['Year', String(d.year)],
    ['Status', d.status],
    ['Role', d.role],
  ].filter(([, v]) => v);
}
---

<!--
  The filmstrip, on the reference's geometry: 300px squares, 10px gaps, scrolled
  horizontally. Native scroll does the work, so it functions with no JavaScript;
  the arrows only add a nicer way to drive it.

  Each tile is a real link to its project page. With JavaScript available the
  click is intercepted and the project expands in place below the rail instead,
  with the full sheet still one click away. Without JavaScript the link simply
  works, which is also what a search engine follows.
-->
<div class="strip-wrap" data-strip-wrap>
  <button class="arrow arrow-prev" type="button" data-strip-prev aria-label="Previous projects" hidden>
    &#8249;
  </button>

  <ul class="strip" data-strip>
    {
      projects.map((p) => (
        <li class="tile" data-tile={p.id}>
          <a
            href={url(`/work/${p.id}`)}
            data-expand={p.id}
            aria-expanded="false"
            aria-controls={`panel-${p.id}`}
          >
            {isFile(p.data.leadImage.src) ? (
              <img
                src={url(p.data.leadImage.src)}
                alt={p.data.leadImage.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Drawing
                kind={p.data.leadImage.kind}
                seed={p.data.leadImage.seed}
                alt={p.data.leadImage.alt}
                reg={false}
              />
            )}
            <span class="tile-label">
              <b>{p.data.title}</b>
              <span>{p.data.category} &nbsp;/&nbsp; {p.data.status}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <button class="arrow arrow-next" type="button" data-strip-next aria-label="More projects" hidden>
    &#8250;
  </button>
</div>

<!--
  The expansions. Rendered server side and closed, so a reader with no
  JavaScript still gets the content, and the browser can reuse the tile images.
-->
<div class="panels" data-panels>
  {
    projects.map((p) => (
      <section
        class="panel"
        id={`panel-${p.id}`}
        data-panel={p.id}
        aria-labelledby={`panel-title-${p.id}`}
        hidden
      >
        <div class="panel-inner">
          <div class="panel-media">
            {isFile(p.data.leadImage.src) ? (
              <img
                src={url(p.data.leadImage.src)}
                alt={p.data.leadImage.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Drawing
                kind={p.data.leadImage.kind}
                seed={p.data.leadImage.seed}
                alt={p.data.leadImage.alt}
                reg={false}
              />
            )}
          </div>

          <div class="panel-text">
            <p class="eyebrow">
              {p.data.category} &nbsp;/&nbsp; <em>{p.data.year}</em>
            </p>
            <h3 class="panel-title" id={`panel-title-${p.id}`} tabindex="-1">
              {p.data.title}
            </h3>
            <p class="panel-summary">{p.data.summary}</p>

            <dl class="panel-facts">
              {facts(p.data).map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>

            <p class="panel-actions">
              <a class="btn" href={url(`/work/${p.id}`)}>
                Full sheet <span class="i" aria-hidden="true">&rarr;</span>
              </a>
              <button class="panel-close" type="button" data-panel-close>Close</button>
            </p>
          </div>
        </div>
      </section>
    ))
  }
</div>
