---
import type { CollectionEntry } from 'astro:content';
import Drawing from './Drawing.astro';
import ProjectCard from './ProjectCard.astro';
import { url } from '../lib/url';
import { tiers } from '../lib/tiers';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

/* Three tiers, all set in the editor, with Ahmad's order kept inside each one.
   Leads are the large cards, the set is the strip, and the index is a short list
   for the thin coursework: it stays on the site and stays clickable, but it does
   not sit at the same size as the work that should be looked at first.

   Derived in src/lib/tiers.ts so this and the PDF cannot disagree. */
const { leads, set, index } = tiers(projects);

const isFile = (s?: string) => Boolean(s && s.startsWith('/'));

/** Only rows that have a value. An empty row is worse than no row. */
function facts(d: CollectionEntry<'projects'>['data']) {
  return [
    ['Type', d.buildingType],
    ['Location', d.location],
    ['Year', String(d.year)],
    ['Status', d.status],
    ['Role', d.role],
  ].filter(([, v]) => v);
}
---

<div class="works" data-grid>
  <ul class="leads">
    {leads.map((p) => <ProjectCard project={p} lead />)}
  </ul>

  {
    set.length > 0 && (
      <div class="rail-head">
        <p class="rail-label">
          The rest of the set <span class="rail-count">{set.length}</span>
        </p>
        <div class="rail-nav">
          <button type="button" class="rail-btn" data-rail-prev aria-label="Scroll projects left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M19 12H6M13 5.5 6.5 12 13 18.5" />
            </svg>
          </button>
          <button type="button" class="rail-btn" data-rail-next aria-label="Scroll projects right">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
            </svg>
          </button>
        </div>
      </div>
    )
  }

  <ul class="rail" data-rail>
    {set.map((p) => <ProjectCard project={p} />)}
  </ul>

  {/* Coursework and case studies. Kept, named, credited and clickable, but not
      given the same room as the work a reviewer should look at first. */}
  {
    index.length > 0 && (
      <div class="index-block">
        <p class="rail-label index-head">
          Also in the archive <span class="rail-count">{index.length}</span>
        </p>
        <ul class="index-list">
          {index.map((p) => (
            <li>
              <a href={url(`/work/${p.id}`)}>
                <span class="index-year">{p.data.year}</span>
                <span class="index-title">{p.data.title}</span>
                <span class="index-kind">{p.data.buildingType}</span>
                <span class="index-credit">{p.data.credit}</span>
                <span class="index-go" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<!--
  The expansions. Rendered server side and closed, so a reader with no
  JavaScript still gets the content, and the browser can reuse the card images.
  Only cards expand; the index links straight through to the project page, so
  building panels for those would be markup nothing can reach.
-->
<div class="panels" data-panels>
  {
    [...leads, ...set].map((p) => (
      <section
        class="panel"
        id={`panel-${p.id}`}
        data-panel={p.id}
        aria-labelledby={`panel-title-${p.id}`}
        hidden
      >
        <div class="panel-inner">
          <div class="panel-media">
            {isFile(p.data.leadImage.src) ? (
              <img
                src={url(p.data.leadImage.src)}
                alt={p.data.leadImage.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Drawing
                kind={p.data.leadImage.kind}
                seed={p.data.leadImage.seed}
                alt={p.data.leadImage.alt}
                reg={false}
              />
            )}
          </div>

          <div class="panel-text">
            <p class="eyebrow">
              {p.data.category} &nbsp;/&nbsp; <em>{p.data.year}</em>
            </p>
            <h3 class="panel-title" id={`panel-title-${p.id}`} tabindex="-1">
              {p.data.title}
            </h3>
            <p class="panel-summary">{p.data.summary}</p>

            <dl class="panel-facts">
              {facts(p.data).map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>

            <p class="panel-actions">
              <a class="btn" href={url(`/work/${p.id}`)}>
                Full sheet <span class="i" aria-hidden="true">&rarr;</span>
              </a>
              <button class="panel-close" type="button" data-panel-close>Close</button>
            </p>
          </div>
        </div>
      </section>
    ))
  }
</div>
