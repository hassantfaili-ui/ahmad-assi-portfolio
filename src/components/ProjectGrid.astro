---
import type { CollectionEntry } from 'astro:content';
import Drawing from './Drawing.astro';
import { url } from '../lib/url';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const isFile = (s?: string) => Boolean(s && s.startsWith('/'));

/** Only rows that have a value. An empty row is worse than no row. */
function facts(d: CollectionEntry<'projects'>['data']) {
  return [
    ['Type', d.buildingType],
    ['Location', d.location],
    ['Year', String(d.year)],
    ['Status', d.status],
    ['Role', d.role],
  ].filter(([, v]) => v);
}
---

<!--
  A grid rather than a rail. Every project is visible at once instead of hidden
  behind a scroll, and each carries its name, so the page reads as an index
  rather than a strip of unlabelled pictures.

  Hierarchy comes from scale within the same grid: a project marked Featured
  claims a two by two cell, the rest take one. Nothing is hidden and the grid
  stays a grid, but the eye is given somewhere to land first. Which projects are
  large, and in what order, is set in the editor.

  Each tile is still a real link to its project page. With JavaScript the click
  is intercepted and the project expands below the grid instead.
-->
<ul class="grid" data-grid>
  {
    projects.map((p) => (
      <li class:list={["tile", p.data.featured && "tile-lead"]} data-tile={p.id}>
        <a
          href={url(`/work/${p.id}`)}
          data-expand={p.id}
          aria-expanded="false"
          aria-controls={`panel-${p.id}`}
        >
          <span class="tile-media">
            {isFile(p.data.leadImage.src) ? (
              <img
                src={url(p.data.leadImage.src)}
                alt={p.data.leadImage.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Drawing
                kind={p.data.leadImage.kind}
                seed={p.data.leadImage.seed}
                alt={p.data.leadImage.alt}
                reg={false}
              />
            )}
          </span>
          <span class="tile-caption">
            <b>{p.data.title}</b>
            <span>{p.data.category} &nbsp;/&nbsp; {p.data.year}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<!--
  The expansions. Rendered server side and closed, so a reader with no
  JavaScript still gets the content, and the browser can reuse the tile images.
-->
<div class="panels" data-panels>
  {
    projects.map((p) => (
      <section
        class="panel"
        id={`panel-${p.id}`}
        data-panel={p.id}
        aria-labelledby={`panel-title-${p.id}`}
        hidden
      >
        <div class="panel-inner">
          <div class="panel-media">
            {isFile(p.data.leadImage.src) ? (
              <img
                src={url(p.data.leadImage.src)}
                alt={p.data.leadImage.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Drawing
                kind={p.data.leadImage.kind}
                seed={p.data.leadImage.seed}
                alt={p.data.leadImage.alt}
                reg={false}
              />
            )}
          </div>

          <div class="panel-text">
            <p class="eyebrow">
              {p.data.category} &nbsp;/&nbsp; <em>{p.data.year}</em>
            </p>
            <h3 class="panel-title" id={`panel-title-${p.id}`} tabindex="-1">
              {p.data.title}
            </h3>
            <p class="panel-summary">{p.data.summary}</p>

            <dl class="panel-facts">
              {facts(p.data).map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>

            <p class="panel-actions">
              <a class="btn" href={url(`/work/${p.id}`)}>
                Full sheet <span class="i" aria-hidden="true">&rarr;</span>
              </a>
              <button class="panel-close" type="button" data-panel-close>Close</button>
            </p>
          </div>
        </div>
      </section>
    ))
  }
</div>
