---
/**
 * The front hero: Ahmad's own renders as a slow moving film, with his
 * introduction over it.
 *
 * The film is built from the project renders in public/media by
 * scripts/build-hero-film.sh, so it is genuinely his work rather than stock
 * footage. Replace hero.mp4 with a walkthrough or flythrough when there is one;
 * nothing else has to change.
 *
 * It never autoplays on a narrow screen or when reduced motion is asked for.
 * In those cases the poster frame shows and the video is never downloaded,
 * which is why the source is held in data-src rather than src.
 */
interface Props {
  eyebrow: string;
  name: string;
  surname: string;
  intro: string;
  ctaLabel: string;
  ctaHref: string;
}

import { url } from '../lib/url';

const { eyebrow, name, surname, intro, ctaLabel, ctaHref } = Astro.props;
---

<section class="film">
  <video
    class="film-media"
    data-hero
    data-src={url("/media/hero.mp4")}
    poster={url("/media/hero-poster.jpg")}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  >
  </video>

  <div class="film-scrim" aria-hidden="true"></div>

  <!--
    Shown only when the film did not start on its own: reduced motion, a narrow
    screen, or a browser that blocked autoplay. Without it the hero looks broken
    to anyone with "Reduce motion" switched on, since they just see a still.
  -->
  <button class="film-start" type="button" data-film-start hidden>
    <span class="film-start-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
    </span>
    Play film
  </button>

  <div class="film-body load">
    <p class="eyebrow" style="--i:0">{eyebrow}</p>
    <h1 style="--i:1">
      {name}<br />
      <span class="thin">{surname}</span>
    </h1>
    <p class="film-intro" style="--i:2">{intro}</p>
    <p style="--i:3; margin:2.25rem 0 0">
      <a class="btn" href={url(ctaHref)}>
        {ctaLabel} <span class="i" aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </div>

  <p class="film-credit" aria-hidden="true">
    Lincoln Beach Center &nbsp;/&nbsp; La Casa Aranas
  </p>
</section>
