---
/**
 * The front hero: the Lincoln Beach Center walkthrough, with Ahmad's
 * introduction over it.
 *
 * This used to be a crossfaded slideshow of stills assembled by
 * scripts/build-hero-film.sh. It is now the real film, which is a better first
 * impression and is unambiguously his work. Built by scripts/build-hero.sh from
 * the 4K original: the first seven seconds are cut because the film carries its
 * own burned-in title card, which would sit on top of Ahmad's name, and the
 * whole thing is capped near 1150 kbps so a page that autoplays on every visit
 * stays about nine megabytes rather than three hundred and fifty.
 *
 * The full quality version stays on YouTube, behind the click-to-load facade on
 * the project page. Nothing is requested from Google for this hero.
 *
 * It never autoplays on a narrow screen or when reduced motion is asked for.
 * In those cases the poster frame shows and the video is never downloaded,
 * which is why the source is held in data-src rather than src.
 */
interface Props {
  eyebrow: string;
  name: string;
  surname: string;
  intro: string;
  ctaLabel: string;
  ctaHref: string;
}

import { url } from '../lib/url';

const { eyebrow, name, surname, intro, ctaLabel, ctaHref } = Astro.props;
---

<section class="film">
  <video
    class="film-media"
    data-hero
    data-src={url("/media/hero.mp4")}
    poster={url("/media/hero-poster.jpg")}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  >
  </video>

  <div class="film-scrim" aria-hidden="true"></div>
  <div class="film-body load">
    <p class="eyebrow" style="--i:0">{eyebrow}</p>
    <h1 style="--i:1">
      {name}<br />
      <span class="thin">{surname}</span>
    </h1>
    <p class="film-intro" style="--i:2">{intro}</p>
    <p style="--i:3; margin:2.25rem 0 0">
      <a class="btn" href={url(ctaHref)}>
        {ctaLabel} <span class="i" aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </div>

  <p class="film-credit" aria-hidden="true">
    Lincoln Beach Center &nbsp;/&nbsp; Walkthrough
  </p>
</section>
