---
/**
 * The front hero: the Lincoln Beach Center walkthrough, with Ahmad's
 * introduction over it.
 *
 * This used to be a crossfaded slideshow of stills. It is now the real film,
 * which is a better first impression and is unambiguously his work. Built by
 * scripts/build-hero.sh from the 4K original: the first seven seconds are cut
 * because the film carries its own burned-in title card, which would sit on top
 * of Ahmad's name.
 *
 * TWO SOURCES, chosen at runtime. This autoplays on every visit, so the size is
 * somebody else's data bill. 1440p goes to viewports 1200 CSS pixels and wider,
 * and 720p at 1.1 Mbps to everything narrower, to anyone on a slow connection,
 * and to anyone who has asked their browser to save data. See src/scripts/site.ts.
 *
 * Note the committed 1440p file was not produced by the current build script.
 * scripts/build-hero.sh encodes at 4000k and says so, which would be about 29MB;
 * hero-1440.mp4 is 42.8MB at 5,955,301 bps. Re-running the script as it stands
 * would therefore also make the film noticeably smaller, which is a quality
 * decision and not a mechanical one, so it has been left alone.
 *
 * True 4K is deliberately not offered here. Sixty seconds of watchable 4K is
 * about 80MB, which every visitor would download before reading a word, for a
 * film that is scrimmed, cropped to the viewport and playing behind text.
 *
 * It autoplays everywhere, including on a phone and with reduced motion set,
 * because that was asked for explicitly. Be aware what that means: a phone
 * visitor downloads the 8MB file whether they wanted moving pictures or not.
 * Every other animation on the site still honours prefers-reduced-motion.
 *
 * The sources are held in data attributes rather than src so nothing starts
 * downloading before the script has chosen which one to use.
 */
interface Props {
  eyebrow: string;
  name: string;
  surname: string;
  intro: string;
  ctaLabel: string;
  ctaHref: string;
}

import { filmUrl, url } from '../lib/url';

const { eyebrow, name, surname, intro, ctaLabel, ctaHref } = Astro.props;
---

<section class="film">
  <video
    class="film-media"
    data-hero
    data-src-large={filmUrl("/media/hero-1440.mp4")}
    data-src-small={filmUrl("/media/hero-720.mp4")}
    poster={url("/media/hero-poster.jpg")}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  >
  </video>

  <div class="film-scrim" aria-hidden="true"></div>
  <div class="film-body load">
    <p class="eyebrow" style="--i:0">{eyebrow}</p>
    <h1 style="--i:1">
      {name}<br />
      <span class="thin">{surname}</span>
    </h1>
    <p class="film-intro" style="--i:2">{intro}</p>
    <p style="--i:3; margin:2.25rem 0 0">
      <a class="btn" href={url(ctaHref)}>
        {ctaLabel} <span class="i" aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </div>

  <p class="film-credit" aria-hidden="true">
    Lincoln Beach Center &nbsp;/&nbsp; Walkthrough
  </p>
</section>
