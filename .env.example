# Postgres. Neon locally and in preview; on Workers the connection string comes
# from the Hyperdrive binding instead and this is only the fallback.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Where published media is served from. Rows store R2 object keys, never URLs,
# so this is the one variable that decides where they resolve.
MEDIA_ORIGIN="https://media.ahmadassi.ca"

# R2, S3 API. Server only. None of these may ever reach the browser.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET="ahmadassi-media"

# Cloudflare Access. The team domain and the application's audience tag, both
# from the Zero Trust dashboard.
CF_ACCESS_TEAM_DOMAIN="ahmadassi.cloudflareaccess.com"
CF_ACCESS_AUD=""

# Local development only. Set it to "true" in your own .env, never here.
#
# It skips Access verification entirely, so /admin is reachable without a
# tunnel. src/lib/env.ts throws on the first identity read when NODE_ENV is
# production, so a deployment that carries it fails loudly rather than serving
# the administration area to anyone. Shipped empty because the file everyone
# copies should not have the bypass switched on in it.
ACCESS_DEV_BYPASS=""
