# Copy to .env for local work. Nothing here is needed to run `npm run dev`,
# which edits the files in this checkout with no account and no network.
# See docs/EDITING.md.

# --- The editor -------------------------------------------------------------
# Both come from app.tina.io. Both are needed: with either one missing the
# build falls back to a local-only client and the deployed editor cannot save.
# The client id is public by design and ends up in the admin bundle either way.
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# --- Film uploads, optional -------------------------------------------------
# Only for uploading walkthrough films to R2 from inside the editor. Leave every
# one of these unset and the film field becomes a path to type, which is how
# films worked before. Set all five or none: half-set is reported as an error by
# `npm run editor:check` rather than half working.
#
# The bucket also needs a CORS rule allowing PUT from the site's own origin,
# because the browser uploads to R2 directly rather than through the site.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# A passphrase you choose. Anyone who has it can write a film into the bucket,
# so treat it like a password and give it only to whoever edits the site.
FILM_UPLOAD_KEY=

# --- Where the films are served from ----------------------------------------
# Committed as a default in src/lib/url.ts, so this only overrides it.
# PUBLIC_MEDIA_ORIGIN=https://media.ahmadassi.ca
