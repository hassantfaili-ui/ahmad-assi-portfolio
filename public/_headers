# Cloudflare Pages reads this from the published output.
# It replaces the [[headers]] blocks that were in netlify.toml.

/media/*
# Media is cached for an hour and then revalidated, deliberately not immutable.
# Keystatic writes an uploaded photo under its own filename, so replacing a
# render with a better version exported under the same name would otherwise
# change nothing for anyone who had already visited, for a year, and that looks
# exactly like the edit not having saved. An hour covers a browsing session;
# after that the ETag answers with a 304 unless the file really did change.
  Cache-Control: public, max-age=3600, must-revalidate

/portfolio/*
  Cache-Control: public, max-age=604800

/_astro/*
# Astro emits hashed filenames here, so these are safe to pin hard.
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/admin
# The editor front door, and the editor itself, must never be cached.
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/keystatic/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
