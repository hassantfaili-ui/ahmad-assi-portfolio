{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://ahmadassi.ca",
          "https://www.ahmadassi.ca",
          "http://localhost:3000"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["content-type", "content-length"]
      },
      "exposeHeaders": ["etag"],
      "maxAgeSeconds": 3600
    }
  ]
}
