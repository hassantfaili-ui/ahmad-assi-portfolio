node_modules/
dist/
.astro/
.DS_Store
*.log
.env
.env.*
!.env.example

# scratch: print sized image copies, regenerated by scripts/build-portfolio.sh
public/print/

# Wrangler build state and its deploy pointer. Committing this once broke the
# Cloudflare deploy: config.json points at dist/server/wrangler.json, which only
# exists when the adapter runs, so a build without it failed looking for a worker
# it never produced.
.wrangler/

# Generated by `tinacms build` and `tinacms dev` on every run: the GraphQL
# client, the TypeScript types and the schema, all derived from tina/config.ts.
# Also declared in tina/.gitignore, which is what the Tina CLI itself writes.
tina/__generated__/

# The admin UI, compiled by `tinacms build` into public/admin. It is a build
# artefact of tina/config.ts, not source, and it is a megabyte of bundled
# JavaScript that would otherwise land in every diff. public/admin/.gitignore
# keeps the folder itself so the dev server has somewhere to serve it from.
public/admin/index.html
public/admin/assets/

# Local Worker variables: the R2 credentials the film upload route reads during
# `npm run dev`. Wrangler's own convention, and never committed. The empty vars
# block in wrangler.jsonc is what makes wrangler look for this file at all.
.dev.vars
.dev.vars.*
